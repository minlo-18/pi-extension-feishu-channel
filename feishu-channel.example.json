{
  "//": "OPTIONAL. Prefer QR login: just run pi and scan (or /feishu-login). Copy this to <project>/.pi/feishu-channel.json only for manual setup. Env vars (FEISHU_*) override these. Never commit real secrets.",
  "appId": "cli_xxxxxxxxxxxxxxxx",
  "appSecret": "your-app-secret",
  "domain": "feishu",

  "onboarding": true,

  "requireMention": true,
  "allowBots": "none",

  "groupPolicy": "open",
  "allowedChats": [],

  "allowedUsers": [],
  "allowAllUsers": false,

  "botOpenId": "",
  "botName": "",

  "replyInGroup": true,
  "maxMessageLength": 8000,

  "richText": true,

  "forwardMedia": true,
  "inboundDir": "",

  "approvalEnabled": false,
  "approvalTools": [],
  "approvalTimeoutMs": 300000,
  "approvalTimeoutAllow": false,

  "streaming": true,
  "streamingThrottleMs": 160,

  "staticCard": true,

  "debounceEnabled": true,
  "debounceMs": 800,

  "queueEnabled": true,
  "queueTaskTimeoutMs": 300000,

  "dedupEnabled": true,
  "dedupTtlMs": 86400000
}
