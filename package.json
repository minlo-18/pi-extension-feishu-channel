{
  "name": "pi-extension-feishu-channel",
  "private": true,
  "version": "0.1.0",
  "description": "Feishu / Lark chat channel for pi-agent. Connects a pi coding-agent session to a Feishu bot over a WebSocket long-connection: inbound IM messages become user prompts, assistant replies stream back as CardKit typewriter cards.",
  "type": "module",
  "license": "MIT",
  "author": "minlo-18",
  "homepage": "https://github.com/minlo-18/pi-extension-feishu-channel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minlo-18/pi-extension-feishu-channel.git"
  },
  "bugs": {
    "url": "https://github.com/minlo-18/pi-extension-feishu-channel/issues"
  },
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "npm run typecheck",
    "check": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "pi-package",
    "feishu",
    "lark",
    "channel"
  ],
  "pi": {
    "extensions": [
      "./bridge.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "qrcode": "^1.5.4",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^24.12.4",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.3"
  }
}
